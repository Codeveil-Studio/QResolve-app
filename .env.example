# Copy this file to .env and fill in the values for local development.
# Never commit .env to git.

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# --- Razorpay (frontend) ---
# The Key ID is safe to expose to the browser. Use rzp_test_* for development,
# rzp_live_* for production. The matching Key Secret is set in Supabase Edge
# Function secrets (see RAZORPAY_INTEGRATION.md).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
